# Example same-origin host. Replace the domain, certificate, and roots.
# This file is not installed by the application. The owner copies it into the web server.
# Content-Security-Policy-Report-Only is intentional. Switch the header name to
# Content-Security-Policy only after a report-only period shows no violations.
# img-src allows https so a published logo URL can load. Do not add script hosts here
# until you know you need them.

server {
    listen 443 ssl;
    http2 on;
    server_name example.com;

    ssl_certificate /etc/ssl/certs/example.com.pem;
    ssl_certificate_key /etc/ssl/private/example.com.key;

    # The public site is the static HTML in frontend/, including page-*.html.
    # After `npm run build`, copy frontend/dist/assets next to admin.html if this
    # root also serves the admin SPA.
    root /var/www/marqetise/frontend;
    index index.html;

    add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location /api/ { proxy_pass http://127.0.0.1:8000; include proxy_params; }
    location /sanctum/ { proxy_pass http://127.0.0.1:8000; include proxy_params; }
    location /storage/ { proxy_pass http://127.0.0.1:8000; include proxy_params; }
    location = /sitemap.xml { proxy_pass http://127.0.0.1:8000; include proxy_params; }
    location = /robots.txt { proxy_pass http://127.0.0.1:8000; include proxy_params; }
    location = /up { proxy_pass http://127.0.0.1:8000; include proxy_params; }

    location = /about { try_files /page-about.html =404; }
    location = /services { try_files /page-services.html =404; }
    location = /courses { try_files /page-courses.html =404; }
    location = /contact { try_files /page-contact.html =404; }
    location = /book { try_files /page-book.html =404; }
    location = /privacy { try_files /page-privacy.html =404; }
    location = /terms { try_files /page-terms.html =404; }

    location ~ ^/courses/([A-Za-z0-9_-]+)$ {
        rewrite ^ /page-course-details.html last;
    }

    location /admin {
        try_files /admin.html =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
