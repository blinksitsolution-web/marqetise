APP_NAME=Marqetise
APP_ENV=local
APP_KEY=
# Production keeps debug off. Local HTTP needs APP_DEBUG=true.
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
# Sample courses stay draft until a person publishes them. Leave this false unless you want those drafts seeded.
SEED_SAMPLE_CONTENT=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marqetise
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Encrypt session payloads. Set SESSION_ENCRYPT=false only when debugging locally.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=localhost
# Local HTTP must use false. Production must set SESSION_SECURE_COOKIE=true.
SESSION_SECURE_COOKIE=false
# Comma-separated addresses of the TLS proxy in front of PHP. Leave empty to ignore X-Forwarded-For. Never use *.
TRUSTED_PROXIES=
# Daily database copy under storage/app/backups. Leave false until that directory is copied off the server.
BACKUP_ENABLED=false
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost,127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@marqetise.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
